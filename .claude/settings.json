{
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest"
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(touch *)"
    ],
    "deny": [
      "Read(/spec/archive/**)",
      "Edit(/spec/archive/**)",
      "Read(/tests/candidate_outputs/**)",
      "Edit(/tests/candidate_outputs/**)",
      "Read(/**/node_modules/**)",
      "Read(/**/.env)",
      "Read(/**/__pycache__/**)",
      "Read(/.git/**)",
      "Edit(/spec/compiled/architecture.yml)",
      "Edit(/lore_hypergraph.yml)",
      "Edit(/lore/CANON.md)",
      "Edit(/lore/canon/**)",
      "Edit(/missions/*/mission.yaml)",
      "Edit(/missions/*/slices/*/slice.yaml)",
      "Read(/PRDs/v0.6.0/**)"
    ],
    "ask": [
      "Bash(python3 .agents/scripts/hyper_lore.py approve *)",
      "Bash(python .agents/scripts/hyper_lore.py approve *)",
      "Bash(python3 .agents/scripts/hyper_lore.py reject *)",
      "Bash(python .agents/scripts/hyper_lore.py reject *)",
      "Bash(python3 .agents/scripts/hyper_lore.py retire *)",
      "Bash(python .agents/scripts/hyper_lore.py retire *)",
      "Bash(python3 .agents/scripts/hyper_lore.py reopen *)",
      "Bash(python .agents/scripts/hyper_lore.py reopen *)",
      "Bash(python3 .agents/scripts/hyper_lore.py review *)",
      "Bash(python .agents/scripts/hyper_lore.py review *)"
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'P=$(basename \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\") && echo \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"SessionStart\\\",\\\"sessionTitle\\\":\\\"$P\\\"}}\"'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.agents/scripts/hyper_gate_hook.py\""
          }
        ]
      }
    ]
  }
}
