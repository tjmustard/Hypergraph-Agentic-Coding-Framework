# --- Hypergraph Agentic Coding Framework Standard Ignores ---

# Framework: Active specifications and unverified outputs (Project-specific)
# We preserve the directory structure via .gitkeep, but ignore the actual files.
/spec/

# Tests: Candidate outputs and fixtures should never be committed to the master template
/tests/

# Python: Standard environment and cache ignores
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env

# OS-specific
.DS_Store
Thumbs.db

# Gemini CLI / Agent-specific temporary files
.gemini/tmp/
*.log
.README.md.swp
.README.md.swp
*.swp

# Temp files and folders
tmp/
.antigravitycli/f2c8e969-053f-4704-b288-7b6eb7cbbf76.json

# HACF v0.6.0: machine-local state, backups, logs and tool workspaces (never committed)
.agents/state/
.agents/.backup/
.agents/logs/
.agents/hacf-manifest.json
/exhaust/
/.openrig/
openrig/hacf/overrides.yml

# BEGIN HACF MANAGED BLOCK: gitignore
.agents/state/
.agents/.backup/
.agents/logs/
/exhaust/
/.openrig/
