{
  "permissions": {
    "deny": [
      "Read(/spec/archive/**)",
      "Edit(/spec/archive/**)",
      "Read(/tests/candidate_outputs/**)",
      "Edit(/tests/candidate_outputs/**)",
      "Read(/**/node_modules/**)",
      "Read(/**/.env)",
      "Read(/**/__pycache__/**)",
